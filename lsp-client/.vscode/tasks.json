{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "npm",
			"script": "compile",
			"group": "build",
			"presentation": {
				"panel": "dedicated",
				"reveal": "never"
			},
			"problemMatcher": [
				"$tsc"
			],
			"dependsOn": [
				"compile-server"
			]
		},
		{
			"type": "npm",
			"script": "watch",
			"isBackground": true,
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"presentation": {
				"panel": "dedicated",
				"reveal": "never"
			},
			"problemMatcher": [
				"$tsc-watch"
			],
			"dependsOn": [
				"compile-server"
			]
		},
		{
			"label": "compile-server",
			"type": "shell",
			"command": "cd ../; ./gradlew jarServer; cd lsp-client; cp ../lsp-server/build/libs/lsp-server.jar ./lsp-server.jar",
			"group": "build"
		}
	]
}